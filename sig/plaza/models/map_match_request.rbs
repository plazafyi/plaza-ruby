module Plaza
  module Models
    type map_match_request =
      { trace: Plaza::GeoJsonGeometry, radiuses: ::Array[Float]? }

    class MapMatchRequest < Plaza::Internal::Type::BaseModel
      attr_accessor trace: Plaza::GeoJsonGeometry

      attr_accessor radiuses: ::Array[Float]?

      def initialize: (
        trace: Plaza::GeoJsonGeometry,
        ?radiuses: ::Array[Float]?
      ) -> void

      def to_hash: -> {
        trace: Plaza::GeoJsonGeometry,
        radiuses: ::Array[Float]?
      }
    end
  end
end
