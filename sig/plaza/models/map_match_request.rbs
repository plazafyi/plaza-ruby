module Plaza
  module Models
    type map_match_request =
      { geometry: Plaza::LineStringGeometry, radiuses: ::Array[Float]? }

    class MapMatchRequest < Plaza::Internal::Type::BaseModel
      attr_accessor geometry: Plaza::LineStringGeometry

      attr_accessor radiuses: ::Array[Float]?

      def initialize: (
        geometry: Plaza::LineStringGeometry,
        ?radiuses: ::Array[Float]?
      ) -> void

      def to_hash: -> {
        geometry: Plaza::LineStringGeometry,
        radiuses: ::Array[Float]?
      }
    end
  end
end
