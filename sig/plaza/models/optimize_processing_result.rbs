module Plaza
  module Models
    type optimize_processing_result =
      {
        job_id: String,
        status: Plaza::Models::OptimizeProcessingResult::status
      }

    class OptimizeProcessingResult < Plaza::Internal::Type::BaseModel
      attr_accessor job_id: String

      attr_accessor status: Plaza::Models::OptimizeProcessingResult::status

      def initialize: (
        job_id: String,
        status: Plaza::Models::OptimizeProcessingResult::status
      ) -> void

      def to_hash: -> {
        job_id: String,
        status: Plaza::Models::OptimizeProcessingResult::status
      }

      type status = :processing

      module Status
        extend Plaza::Internal::Type::Enum

        PROCESSING: :processing

        def self?.values: -> ::Array[Plaza::Models::OptimizeProcessingResult::status]
      end
    end
  end
end
