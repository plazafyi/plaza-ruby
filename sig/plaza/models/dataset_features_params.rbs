module Plaza
  module Models
    type dataset_features_params =
      {
        id: String,
        cursor: String,
        format_: String,
        limit: Integer,
        output_buffer: Float,
        output_centroid: bool,
        output_fields: String,
        output_geometry: bool,
        output_include: String,
        output_precision: Integer,
        output_simplify: Float,
        output_sort: String
      }
      & Plaza::Internal::Type::request_parameters

    class DatasetFeaturesParams < Plaza::Internal::Type::BaseModel
      extend Plaza::Internal::Type::RequestParameters::Converter
      include Plaza::Internal::Type::RequestParameters

      attr_accessor id: String

      attr_reader cursor: String?

      def cursor=: (String) -> String

      attr_reader format_: String?

      def format_=: (String) -> String

      attr_reader limit: Integer?

      def limit=: (Integer) -> Integer

      attr_reader output_buffer: Float?

      def output_buffer=: (Float) -> Float

      attr_reader output_centroid: bool?

      def output_centroid=: (bool) -> bool

      attr_reader output_fields: String?

      def output_fields=: (String) -> String

      attr_reader output_geometry: bool?

      def output_geometry=: (bool) -> bool

      attr_reader output_include: String?

      def output_include=: (String) -> String

      attr_reader output_precision: Integer?

      def output_precision=: (Integer) -> Integer

      attr_reader output_simplify: Float?

      def output_simplify=: (Float) -> Float

      attr_reader output_sort: String?

      def output_sort=: (String) -> String

      def initialize: (
        id: String,
        ?cursor: String,
        ?format_: String,
        ?limit: Integer,
        ?output_buffer: Float,
        ?output_centroid: bool,
        ?output_fields: String,
        ?output_geometry: bool,
        ?output_include: String,
        ?output_precision: Integer,
        ?output_simplify: Float,
        ?output_sort: String,
        ?request_options: Plaza::request_opts
      ) -> void

      def to_hash: -> {
        id: String,
        cursor: String,
        format_: String,
        limit: Integer,
        output_buffer: Float,
        output_centroid: bool,
        output_fields: String,
        output_geometry: bool,
        output_include: String,
        output_precision: Integer,
        output_simplify: Float,
        output_sort: String,
        request_options: Plaza::RequestOptions
      }
    end
  end
end
