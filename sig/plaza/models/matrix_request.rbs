module Plaza
  module Models
    type matrix_request =
      {
        destinations: Plaza::GeoJsonGeometry,
        origins: Plaza::GeoJsonGeometry,
        mode: Plaza::Models::MatrixRequest::mode
      }

    class MatrixRequest < Plaza::Internal::Type::BaseModel
      attr_accessor destinations: Plaza::GeoJsonGeometry

      attr_accessor origins: Plaza::GeoJsonGeometry

      attr_reader mode: Plaza::Models::MatrixRequest::mode?

      def mode=: (
        Plaza::Models::MatrixRequest::mode
      ) -> Plaza::Models::MatrixRequest::mode

      def initialize: (
        destinations: Plaza::GeoJsonGeometry,
        origins: Plaza::GeoJsonGeometry,
        ?mode: Plaza::Models::MatrixRequest::mode
      ) -> void

      def to_hash: -> {
        destinations: Plaza::GeoJsonGeometry,
        origins: Plaza::GeoJsonGeometry,
        mode: Plaza::Models::MatrixRequest::mode
      }

      type mode = :auto | :foot | :bicycle

      module Mode
        extend Plaza::Internal::Type::Enum

        AUTO: :auto
        FOOT: :foot
        BICYCLE: :bicycle

        def self?.values: -> ::Array[Plaza::Models::MatrixRequest::mode]
      end
    end
  end
end
