    class RouteResult < Plaza::Internal::Type::BaseModel
      attr_accessor geometry: Plaza::GeoJsonGeometry

      attr_accessor properties: Plaza::RouteResult::Properties

      attr_accessor type: Plaza::Models::RouteResult::type_

      def initialize: (
