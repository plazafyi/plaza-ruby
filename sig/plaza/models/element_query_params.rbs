module Plaza
  module Models
    type element_query_params =
      {
        bbox: String,
        contains: String,
        crosses: String,
        cursor: String,
        format_: String,
        :h3 => String,
        intersects: String,
        limit: Integer,
        near: String,
        output_buffer: Float,
        output_centroid: bool,
        output_fields: String,
        output_geometry: bool,
        output_include: String,
        output_precision: Integer,
        output_simplify: Float,
        output_sort: String,
        radius: Float,
        touches: String,
        type: String,
        within: String
      }
      & Plaza::Internal::Type::request_parameters

    class ElementQueryParams < Plaza::Internal::Type::BaseModel
      extend Plaza::Internal::Type::RequestParameters::Converter
      include Plaza::Internal::Type::RequestParameters

      attr_reader bbox: String?

      def bbox=: (String) -> String

      attr_reader contains: String?

      def contains=: (String) -> String

      attr_reader crosses: String?

      def crosses=: (String) -> String

      attr_reader cursor: String?

      def cursor=: (String) -> String

      attr_reader format_: String?

      def format_=: (String) -> String

      attr_reader h3: String?

      def h3=: (String) -> String

      attr_reader intersects: String?

      def intersects=: (String) -> String

      attr_reader limit: Integer?

      def limit=: (Integer) -> Integer

      attr_reader near: String?

      def near=: (String) -> String

      attr_reader output_buffer: Float?

      def output_buffer=: (Float) -> Float

      attr_reader output_centroid: bool?

      def output_centroid=: (bool) -> bool

      attr_reader output_fields: String?

      def output_fields=: (String) -> String

      attr_reader output_geometry: bool?

      def output_geometry=: (bool) -> bool

      attr_reader output_include: String?

      def output_include=: (String) -> String

      attr_reader output_precision: Integer?

      def output_precision=: (Integer) -> Integer

      attr_reader output_simplify: Float?

      def output_simplify=: (Float) -> Float

      attr_reader output_sort: String?

      def output_sort=: (String) -> String

      attr_reader radius: Float?

      def radius=: (Float) -> Float

      attr_reader touches: String?

      def touches=: (String) -> String

      attr_reader type: String?

      def type=: (String) -> String

      attr_reader within: String?

      def within=: (String) -> String

      def initialize: (
        ?bbox: String,
        ?contains: String,
        ?crosses: String,
        ?cursor: String,
        ?format_: String,
        ?h3: String,
        ?intersects: String,
        ?limit: Integer,
        ?near: String,
        ?output_buffer: Float,
        ?output_centroid: bool,
        ?output_fields: String,
        ?output_geometry: bool,
        ?output_include: String,
        ?output_precision: Integer,
        ?output_simplify: Float,
        ?output_sort: String,
        ?radius: Float,
        ?touches: String,
        ?type: String,
        ?within: String,
        ?request_options: Plaza::request_opts
      ) -> void

      def to_hash: -> {
        bbox: String,
        contains: String,
        crosses: String,
        cursor: String,
        format_: String,
        :h3 => String,
        intersects: String,
        limit: Integer,
        near: String,
        output_buffer: Float,
        output_centroid: bool,
        output_fields: String,
        output_geometry: bool,
        output_include: String,
        output_precision: Integer,
        output_simplify: Float,
        output_sort: String,
        radius: Float,
        touches: String,
        type: String,
        within: String,
        request_options: Plaza::RequestOptions
      }
    end
  end
end
