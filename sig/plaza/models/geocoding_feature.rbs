module Plaza
  module Models
    type geocoding_feature =
      {
        geometry: Plaza::GeoJsonGeometry,
        properties: Plaza::GeocodingFeature::Properties,
        type: Plaza::Models::GeocodingFeature::type_
      }

    class GeocodingFeature < Plaza::Internal::Type::BaseModel
      attr_accessor geometry: Plaza::GeoJsonGeometry

      attr_accessor properties: Plaza::GeocodingFeature::Properties

      attr_accessor type: Plaza::Models::GeocodingFeature::type_

      def initialize: (
        geometry: Plaza::GeoJsonGeometry,
        properties: Plaza::GeocodingFeature::Properties,
        type: Plaza::Models::GeocodingFeature::type_
      ) -> void

      def to_hash: -> {
        geometry: Plaza::GeoJsonGeometry,
        properties: Plaza::GeocodingFeature::Properties,
        type: Plaza::Models::GeocodingFeature::type_
      }

      type properties =
        {
          country_code: String?,
          display_name: String,
          distance_m: Float?,
          osm_id: Integer?,
          osm_type: String?,
          score: Float?,
          source: String?
        }

      class Properties < Plaza::Internal::Type::BaseModel
        attr_accessor country_code: String?

        attr_reader display_name: String?

        def display_name=: (String) -> String

        attr_accessor distance_m: Float?

        attr_accessor osm_id: Integer?

        attr_accessor osm_type: String?

        attr_accessor score: Float?

        attr_accessor source: String?

        def initialize: (
          ?country_code: String?,
          ?display_name: String,
          ?distance_m: Float?,
          ?osm_id: Integer?,
          ?osm_type: String?,
          ?score: Float?,
          ?source: String?
        ) -> void

        def to_hash: -> {
          country_code: String?,
          display_name: String,
          distance_m: Float?,
          osm_id: Integer?,
          osm_type: String?,
          score: Float?,
          source: String?
        }
      end

      type type_ = :Feature

      module Type
        extend Plaza::Internal::Type::Enum

        FEATURE: :Feature

        def self?.values: -> ::Array[Plaza::Models::GeocodingFeature::type_]
      end
