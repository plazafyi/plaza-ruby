module Plaza
  module Resources
    class Elevation
      def batch: (
        coordinates: ::Array[Plaza::ElevationBatchParams::Coordinate],
        ?request_options: Plaza::request_opts
      ) -> Plaza::ElevationBatchResult

      def lookup: (
        ?lat: Float,
        ?lng: Float,
        ?locations: String,
        ?output_fields: String,
        ?output_include: String,
        ?output_precision: Integer,
        ?request_options: Plaza::request_opts
      ) -> Plaza::ElevationLookupResult

      def lookup_post: (
        ?lat: Float,
        ?lng: Float,
        ?locations: String,
        ?output_fields: String,
        ?output_include: String,
        ?output_precision: Integer,
        ?request_options: Plaza::request_opts
      ) -> Plaza::ElevationLookupResult

      def profile: (
        coordinates: ::Array[Plaza::ElevationProfileRequest::Coordinate],
        ?request_options: Plaza::request_opts
      ) -> Plaza::ElevationProfileResult

      def initialize: (client: Plaza::Client) -> void
    end
  end
end
