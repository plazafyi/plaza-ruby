module Plaza
  module Resources
    class Datasets
      def create: (
        name: String,
        slug: String,
        ?attribution: String?,
        ?description: String?,
        ?license: String?,
        ?source_url: String?,
        ?strict_mode: bool?,
        ?request_options: Plaza::request_opts
      ) -> Plaza::Dataset

      def retrieve: (
        String id,
        ?request_options: Plaza::request_opts
      ) -> Plaza::Dataset

      def list: (
        ?scope: String,
        ?request_options: Plaza::request_opts
      ) -> Plaza::DatasetList

      def delete: (String id, ?request_options: Plaza::request_opts) -> nil

      def initialize: (client: Plaza::Client) -> void
    end
  end
end
