module PlazaSDK
  module Models
    type optimize_request =
      {
        waypoints: PlazaSDK::GeoJsonGeometry,
        mode: PlazaSDK::Models::OptimizeRequest::mode,
        roundtrip: bool
      }

    class OptimizeRequest < PlazaSDK::Internal::Type::BaseModel
      attr_accessor waypoints: PlazaSDK::GeoJsonGeometry

      attr_reader mode: PlazaSDK::Models::OptimizeRequest::mode?

      def mode=: (
        PlazaSDK::Models::OptimizeRequest::mode
      ) -> PlazaSDK::Models::OptimizeRequest::mode

      attr_reader roundtrip: bool?

      def roundtrip=: (bool) -> bool

      def initialize: (
        waypoints: PlazaSDK::GeoJsonGeometry,
        ?mode: PlazaSDK::Models::OptimizeRequest::mode,
        ?roundtrip: bool
      ) -> void

      def to_hash: -> {
        waypoints: PlazaSDK::GeoJsonGeometry,
        mode: PlazaSDK::Models::OptimizeRequest::mode,
        roundtrip: bool
      }

      type mode = :auto | :foot | :bicycle

      module Mode
        extend PlazaSDK::Internal::Type::Enum

        AUTO: :auto
        FOOT: :foot
        BICYCLE: :bicycle

        def self?.values: -> ::Array[PlazaSDK::Models::OptimizeRequest::mode]
      end
    end
  end
end
