module PlazaSDK
  module Models
    type geocode_forward_params =
      {
        q: String,
        bbox: String,
        country_code: String,
        lang: String,
        lat: Float,
        layer: String,
        limit: Integer,
        lng: Float
      }
      & PlazaSDK::Internal::Type::request_parameters

    class GeocodeForwardParams < PlazaSDK::Internal::Type::BaseModel
      extend PlazaSDK::Internal::Type::RequestParameters::Converter
      include PlazaSDK::Internal::Type::RequestParameters

      attr_accessor q: String

      attr_reader bbox: String?

      def bbox=: (String) -> String

      attr_reader country_code: String?

      def country_code=: (String) -> String

      attr_reader lang: String?

      def lang=: (String) -> String

      attr_reader lat: Float?

      def lat=: (Float) -> Float

      attr_reader layer: String?

      def layer=: (String) -> String

      attr_reader limit: Integer?

      def limit=: (Integer) -> Integer

      attr_reader lng: Float?

      def lng=: (Float) -> Float

      def initialize: (
        q: String,
        ?bbox: String,
        ?country_code: String,
        ?lang: String,
        ?lat: Float,
        ?layer: String,
        ?limit: Integer,
        ?lng: Float,
        ?request_options: PlazaSDK::request_opts
      ) -> void

      def to_hash: -> {
        q: String,
        bbox: String,
        country_code: String,
        lang: String,
        lat: Float,
        layer: String,
        limit: Integer,
        lng: Float,
        request_options: PlazaSDK::RequestOptions
      }
    end
  end
end
