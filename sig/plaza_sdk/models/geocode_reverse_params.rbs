module PlazaSDK
  module Models
    type geocode_reverse_params =
      {
        lat: Float,
        lng: Float,
        lang: String,
        layer: String,
        limit: Integer,
        radius: Integer
      }
      & PlazaSDK::Internal::Type::request_parameters

    class GeocodeReverseParams < PlazaSDK::Internal::Type::BaseModel
      extend PlazaSDK::Internal::Type::RequestParameters::Converter
      include PlazaSDK::Internal::Type::RequestParameters

      attr_accessor lat: Float

      attr_accessor lng: Float

      attr_reader lang: String?

      def lang=: (String) -> String

      attr_reader layer: String?

      def layer=: (String) -> String

      attr_reader limit: Integer?

      def limit=: (Integer) -> Integer

      attr_reader radius: Integer?

      def radius=: (Integer) -> Integer

      def initialize: (
        lat: Float,
        lng: Float,
        ?lang: String,
        ?layer: String,
        ?limit: Integer,
        ?radius: Integer,
        ?request_options: PlazaSDK::request_opts
      ) -> void

      def to_hash: -> {
        lat: Float,
        lng: Float,
        lang: String,
        layer: String,
        limit: Integer,
        radius: Integer,
        request_options: PlazaSDK::RequestOptions
      }
    end
  end
end
