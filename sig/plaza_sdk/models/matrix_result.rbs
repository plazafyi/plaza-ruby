module PlazaSDK
  module Models
    type matrix_result =
      {
        distances: ::Array[::Array[Float?]],
        durations: ::Array[::Array[Float?]]
      }

    class MatrixResult < PlazaSDK::Internal::Type::BaseModel
      attr_accessor distances: ::Array[::Array[Float?]]

      attr_accessor durations: ::Array[::Array[Float?]]

      def initialize: (
        distances: ::Array[::Array[Float?]],
        durations: ::Array[::Array[Float?]]
      ) -> void

      def to_hash: -> {
        distances: ::Array[::Array[Float?]],
        durations: ::Array[::Array[Float?]]
      }
    end
  end
end
