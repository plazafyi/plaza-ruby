module PlazaSDK
  module Models
    type routing_nearest_params =
      { lat: Float, lng: Float, radius: Integer }
      & PlazaSDK::Internal::Type::request_parameters

    class RoutingNearestParams < PlazaSDK::Internal::Type::BaseModel
      extend PlazaSDK::Internal::Type::RequestParameters::Converter
      include PlazaSDK::Internal::Type::RequestParameters

      attr_accessor lat: Float

      attr_accessor lng: Float

      attr_reader radius: Integer?

      def radius=: (Integer) -> Integer

      def initialize: (
        lat: Float,
        lng: Float,
        ?radius: Integer,
        ?request_options: PlazaSDK::request_opts
      ) -> void

      def to_hash: -> {
        lat: Float,
        lng: Float,
        radius: Integer,
        request_options: PlazaSDK::RequestOptions
      }
    end
  end
end
